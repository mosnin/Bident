<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- V8 and Cesium's WASM decoders need JIT under the hardened runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- The bundled Vite server loads esbuild/rollup native binaries that are
         not signed with the app's team identity. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Hands-free voice control. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- RTL-SDR radio dongles (WebUSB). -->
    <key>com.apple.security.device.usb</key>
    <true/>
  </dict>
</plist>
